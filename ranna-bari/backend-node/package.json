{
  "name": "rannabari-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "migrate:sqlite": "tsx scripts/migrate-from-sqlite.ts",
    "test": "tsx scripts/check-sessions.ts && vitest run",
    "test:watch": "vitest",
    "seed:local": "tsx scripts/seed-local.ts",
    "check:sessions": "tsx scripts/check-sessions.ts",
    "routes": "tsx scripts/routes.ts",
    "dev:local": "tsx scripts/dev-local.ts"
  },
  "dependencies": {
    "@fastify/aws-lambda": "^6.4.1",
    "@fastify/cors": "^10.0.2",
    "fastify": "^5.2.1",
    "jose": "^6.0.8",
    "mongoose": "^8.10.1",
    "otpauth": "^9.4.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^22.13.5",
    "@types/ws": "^8.5.14",
    "mongodb-memory-server": "^10.1.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
