# The database. Put the real password in .env, which is gitignored.
# A connection string in git history is a rotated password, not a fixed bug.
MONGODB_URI="mongodb+srv://<user>:<password>@cluster0.4uctodg.mongodb.net/rannabari?retryWrites=true&w=majority&appName=Cluster0"

PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Two auth realms, two secrets. They must never be the same value: an admin
# session must not verify as an app token, and sharing a secret is how that
# stops being true.
ADMIN_AUTH_SECRET="change-me-admin-secret-at-least-32-characters-long"
APP_AUTH_SECRET="change-me-app-secret-at-least-32-characters-long"

# What the admin panel presents to prove it is the admin panel. The backend
# will not take the panel's word for who is acting without it.
BACKEND_SERVICE_TOKEN="change-me-service-token-at-least-32-characters"

# none = print the OTP to the log and return it in the response. Set a real
# provider before this goes anywhere near a customer; the code refuses to
# return a code once this is set to anything else.
SMS_PROVIDER="none"

# Where the admin panel is, for CORS.
ADMIN_ORIGIN="http://localhost:3100"
