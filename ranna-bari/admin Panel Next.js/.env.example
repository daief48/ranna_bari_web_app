DATABASE_URL="file:./dev.db"

# The operator realm's secret — one value, shared with backend-node's
# ADMIN_AUTH_SECRET. The backend issues the session cookie and the panel
# verifies it, so the two must match or every sign-in is gibberish to the
# other side. Generate 32+ random bytes; never reuse a value from a repo.
#   openssl rand -hex 32
ADMIN_AUTH_SECRET="change-me-generate-a-real-32-plus-character-secret"
# Legacy name for the same thing. Read only when ADMIN_AUTH_SECRET is unset.
# AUTH_SECRET=""

# Operator seeded by prisma/seed.ts on an empty database. The seed is a no-op
# once any operator exists and never resets a password. In production the
# password MUST be set — the seed refuses to fall back to a known string.
SEED_ADMIN_EMAIL="admin@rannabari.app"
SEED_ADMIN_PASSWORD="change-me-before-first-deploy"

# App-account tokens are signed with their own secret, never the admin one.
APP_AUTH_SECRET="change-me-generate-a-different-32-plus-character-secret"

# none = print OTP codes to the log and return them in dev. Set a real
# provider before this goes anywhere near a customer.
SMS_PROVIDER="none"

# The Node backend this panel is a client of.
BACKEND_URL="http://localhost:4000"

# Proves to the backend that this really is the admin panel. It must match
# BACKEND_SERVICE_TOKEN in backend-node/.env — without it the backend ignores
# the operator this panel says is acting, which is the whole point.
BACKEND_SERVICE_TOKEN="change-me-service-token-at-least-32-characters"

# In production (NODE_ENV=production) ADMIN_AUTH_SECRET and
# BACKEND_SERVICE_TOKEN are required: the panel throws at boot without them.
# On Netlify set every value above in the site's environment variables, not
# in netlify.toml.
